    {
      "id": "refactoring_0001",
      "before_code": "def process_user(name, email, age, address, phone):\n    # Too many parameters\n    pass",
      "after_code": "class UserInfo:\n    def __init__(self, name, email, age, address, phone):\n        self.name = name\n        self.email = email\n        self.age = age\n        self.address = address\n        self.phone = phone\n\ndef process_user(user_info: UserInfo):\n    pass",
      "refactoring_pattern": "introduce_parameter_object",
      "language": "python",
      "code_smell": "long_parameter_list",
      "training_objective": "code_refactoring"
    },
    {
      "id": "refactoring_0002",
      "before_code": "if (user.type === 'admin') {\n    // admin logic\n} else if (user.type === 'moderator') {\n    // moderator logic\n} else if (user.type === 'user') {\n    // user logic\n}",
      "after_code": "const handlers = {\n    admin: () => { /* admin logic */ },\n    moderator: () => { /* moderator logic */ },\n    user: () => { /* user logic */ }\n};\n\nhandlers[user.type]();",
      "refactoring_pattern": "replace_conditional_with_polymorphism",
      "language": "javascript",
      "code_smell": "switch_statements",
      "training_objective": "code_refactoring"
    },
    {
      "id": "refactoring_0003",
      "before_code": "public void calculateTotal() {\n    double total = 0;\n    for (Item item : items) {\n        total += item.price * item.quantity;\n        if (item.discount > 0) {\n            total -= item.discount;\n        }\n    }\n    this.total = total;\n}",
      "after_code": "public void calculateTotal() {\n    this.total = items.stream()\n        .mapToDouble(item -> item.getDiscountedPrice())\n        .sum();\n}\n\nclass Item {\n    double getDiscountedPrice() {\n        return price * quantity - discount;\n    }\n}",
      "refactoring_pattern": "extract_method",
      "language": "java",
      "code_smell": "long_method",
      "training_objective": "code_refactoring"
    },
    {
      "id": "refactoring_0004",
      "before_code": "def get_user_data(id):\n    user = db.query('SELECT * FROM users WHERE id = ' + str(id))\n    return user",
      "after_code": "def get_user_data(id):\n    query = 'SELECT * FROM users WHERE id = ?'\n    user = db.query(query, (id,))\n    return user",
      "refactoring_pattern": "security_fix",
      "language": "python",
      "code_smell": "sql_injection_vulnerability",
      "training_objective": "code_refactoring"
    },
